<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.rstm.yoga.redeploy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rustam/Projects/yoga/scripts/redeploy.sh</string>
    </array>
    <!-- Every 2 hours (a missed run fires at next wake); the script exits
         at once while the profile on the device has >2 days left, and
         otherwise waits up to 10 min for the iPhone to show up on Wi-Fi. -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>StandardOutPath</key>
    <string>/Users/rustam/Library/Logs/Yoga/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rustam/Library/Logs/Yoga/launchd.log</string>
</dict>
</plist>
